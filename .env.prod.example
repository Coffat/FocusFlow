# ==============================================================================
# FocusFlow — Production Environment Template (.env.prod.example)
# ==============================================================================
# Copy to `.env.prod` on the target VPS, replace ALL placeholder values with
# real production secrets, and restrict permissions (`chmod 600 .env.prod`).
# NEVER commit `.env.prod` to version control.
# ==============================================================================

# --- RUNTIME & RELEASE MODE ---
ENVIRONMENT=production
DEBUG=false
# FREE_BETA disables checkout & mock-confirm fail-closed across all environments
BILLING_RELEASE_MODE=FREE_BETA

# --- FRONTEND EDGE BINDING (behind host TLS reverse proxy e.g. Caddy/Nginx) ---
# Keep 127.0.0.1 when terminating TLS on the host reverse proxy; use 0.0.0.0 only if exposed directly
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8080

# --- POSTGRESQL 16 (pgvector) ---
POSTGRES_USER=focusflow_prod_user
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=focusflow_prod
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- REDIS 7 (AOF + Streams, authenticated) ---
# Generate: openssl rand -base64 32
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb

# --- SECURITY, ENCRYPTION & AUTH ---
# Generate JWT signing key (64 hex chars): openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET_KEY
# Generate Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_VALID_32_BYTE_URLSAFE_BASE64_FERNET_KEY
# Generate dedicated Fernet key for Google Calendar OAuth tokens (required in production)
CALENDAR_ENCRYPTION_KEY=REPLACE_WITH_VALID_32_BYTE_URLSAFE_BASE64_FERNET_KEY
# Generate WebCal salt: openssl rand -hex 32
WEBCAL_SALT=REPLACE_WITH_64_HEX_CHAR_WEBCAL_SALT

# --- PUBLIC ORIGINS, CORS, CSRF & RATE LIMITING ---
FRONTEND_URL=https://app.example.com
# Explicit JSON array of allowed origins (wildcards '*' are rejected in production)
BACKEND_CORS_ORIGINS=["https://app.example.com"]
# Optional extra trusted origins for cookie-authenticated CSRF checks
CSRF_TRUSTED_ORIGINS=["https://app.example.com"]
RATE_LIMIT_ENABLED=true
# CIDRs of trusted reverse proxies allowed to supply X-Forwarded-For
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- GOOGLE CALENDAR OAUTH & WEBHOOKS ---
CALENDAR_PROVIDER=google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://app.example.com/api/v1/account/calendar/google/callback
# Must be a public HTTPS URL reachable by Google Calendar push notifications
CALENDAR_WEBHOOK_BASE_URL=https://app.example.com

# --- PRODUCTION SMTP (OTP & Notifications — NO Mailpit) ---
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_WITH_SMTP_USERNAME
EMAIL_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM="FocusFlow Support <no-reply@example.com>"

# --- AI HARNESS (LLM Gateway / Gemini) ---
LLM_PROVIDER=gemini
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_BASE_URL=https://llm-gateway.example.com
# model_suffix (Gemini/cobhub) | param (standard API parameter)
LLM_THINKING_CONTROL=model_suffix
LLM_MODEL=gemini-3.8-flash-medium
LLM_MODEL_LOW=gemini-3.8-flash-low
LLM_MODEL_MEDIUM=gemini-3.8-flash-medium
LLM_MODEL_HIGH=gemini-3.8-flash-high
LLM_FALLBACK_MODELS=
AI_HARD_TIMEOUT_SECONDS=55
AI_DECOMPOSER_MAX_CONCURRENCY=4
AI_PROPOSAL_FINALIZE_RESERVE_SECONDS=14

# --- EMBEDDINGS (Google AI Studio — isolated from LLM gateway) ---
EMBEDDING_PROVIDER=google_ai_studio
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=768

# --- RAG KNOWLEDGE SOURCES ---
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_FILE_MAX_BYTES=20971520

# --- PAYMENTS (Disabled under BILLING_RELEASE_MODE=FREE_BETA) ---
PAYMENT_PROVIDER=sepay
PAYMENT_WEBHOOK_SECRET=
