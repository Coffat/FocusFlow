# ==========================================
# Stage 1: Build Angular 21 Production SPA
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm matching package.json packageManager
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Install dependencies strictly from lockfile
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy application source and build production bundle
COPY . .
RUN pnpm exec ng build --configuration production

# ==========================================
# Stage 2: Serve SPA & API proxy via Nginx (non-root)
# ==========================================
FROM nginx:1.27-alpine AS runner

# Remove default Nginx web root and site config
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy built Angular artifacts (verified outputPath in angular.json: dist/focusflow-frontend)
COPY --from=builder /app/dist/focusflow-frontend/browser /usr/share/nginx/html

# Copy production Nginx SPA & SSE reverse-proxy config
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Prepare writable runtime directories and unprivileged nginx.conf (avoid duplicate pid directive)
RUN sed -i 's|^pid .*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && sed -i '/^user /d' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && touch /tmp/nginx.pid \
    && chown nginx:nginx /tmp/nginx.pid

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
