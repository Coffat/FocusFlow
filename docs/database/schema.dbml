// FocusFlow — Physical Database Schema v3.0 (PostgreSQL 16)
// Generated for dbdiagram.io (DBML - Database Markup Language)
// 24 Tables across 4 Bounded Contexts + Shared Kernel: 9 / 5 / 5 / 3 / 2

Project FocusFlow_v3 {
  database_type: 'PostgreSQL 16'
  Note: '''
    # FocusFlow Physical Database Schema v3.0
    - Bounded Contexts: account (9), planning (5), execution (5), evaluation (3), shared_kernel (2)
    - Primary Keys: UUIDv7 (RFC 9562 Monotonic Time-Ordered)
    - Architecture: Context-First Modular Monolith + Hexagonal Architecture
  '''
}

// ============================================================================
// BOUNDED CONTEXT 1: ACCOUNT & BILLING (9 TABLES)
// ============================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'UUIDv7 Primary Key']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(100) [not null]
  timezone varchar(50) [not null, default: 'Asia/Ho_Chi_Minh']
  role varchar(20) [not null, default: 'LEARNER', note: 'LEARNER, ADMIN']
  tier varchar(20) [not null, default: 'FREE', note: 'FREE, PREMIUM']
  is_locked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Learner & Admin identity core entity'
}

Table learner_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - users.id]
  optimal_focus_duration_mins integer [not null, default: 25]
  peak_productivity_slots jsonb [not null, default: '["MORNING", "EVENING"]']
  estimation_bias_factor numeric(4,2) [not null, default: 1.00]
  weekly_completion_rate numeric(5,2) [not null, default: 0.00]
  total_completed_sessions integer [not null, default: 0]
  is_cold_start boolean [not null, default: true]
  last_aggregated_at timestamptz [default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Zimmerman Self-Regulated Learning (SRL) behavioral profile'
}

Table webcal_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - users.id]
  token_hash varchar(64) [not null, unique]
  oauth_refresh_token_encrypted text
  external_calendar_id varchar(255)
  is_active boolean [not null, default: true]
  last_used_at timestamptz
  rotated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'External calendar integration & secret WebCal feed token'
}

Table availabilities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - users.id]
  mode varchar(20) [not null, default: 'MODE_A', note: 'MODE_A, MODE_B']
  calendar_integration_mode varchar(20) [not null, default: 'NONE', note: 'NONE, BUSY_OVERLAY, TWO_WAY']
  daily_quotas jsonb [not null, default: '{}', note: 'Minutes per weekday for Mode A']
  min_session_minutes integer [not null, default: 30]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Learner weekly availability strategy and baseline'
}

Table availability_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  availability_id uuid [not null, ref: > availabilities.id]
  day_of_week smallint [not null, note: '0=Mon .. 6=Sun']
  start_time time [not null]
  end_time time [not null]
  end_day_offset smallint [not null, default: 0, note: '0=same day, 1=next day overnight']
  slot_type varchar(20) [not null, default: 'ALLOWED', note: 'ALLOWED, FIXED']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '3NF normalized discrete time slots for Mode B'
}

Table ai_quotas {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - users.id]
  monthly_limit integer [not null, default: 30, note: '30 for FREE, 300 for PREMIUM']
  used_calls integer [not null, default: 0]
  reserved_calls integer [not null, default: 0]
  tokens_consumed bigint [not null, default: 0]
  cycle_start timestamptz [not null]
  cycle_end timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Monthly AI tier quota and consumption telemetry'
}

Table ai_quota_reservations {
  id uuid [pk, default: `gen_random_uuid()`]
  quota_id uuid [not null, ref: > ai_quotas.id]
  user_id uuid [not null, ref: > users.id]
  operation_type varchar(50) [not null]
  status varchar(20) [not null, default: 'RESERVED', note: 'RESERVED, COMMITTED, RELEASED']
  tokens_reserved integer [not null, default: 0]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  Note: '2-Phase ACID reservation preventing AI call overrun'
}

Table ai_usage_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  action_type varchar(50) [not null]
  model_name varchar(100) [not null, default: 'gpt-4o-mini']
  prompt_tokens integer [not null, default: 0]
  completion_tokens integer [not null, default: 0]
  total_tokens integer [not null, default: 0]
  latency_ms integer [not null, default: 0]
  status varchar(20) [not null, default: 'SUCCESS', note: 'SUCCESS, ERROR']
  error_message text
  created_at timestamptz [not null, default: `now()`]

  Note: 'Granular prompt & completion telemetry audit log'
}

Table payment_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  transaction_ref varchar(100) [not null, unique]
  gateway_provider varchar(20) [not null, default: 'PAYOS']
  amount_vnd integer [not null]
  currency varchar(10) [not null, default: 'VND']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, PAID, CANCELLED, FAILED']
  qr_code_url text
  webhook_signature_verified boolean [not null, default: false]
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'PayOS QR payment orders and subscription upgrades'
}

// ============================================================================
// BOUNDED CONTEXT 2: PLANNING (5 TABLES)
// ============================================================================

Table goals {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  title text [not null]
  raw_description text [not null]
  target_date date
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, ARCHIVED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'High-level learning objective'
}

Table roadmaps {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  goal_id uuid [not null, ref: > goals.id]
  title varchar(255) [not null]
  description text
  status varchar(20) [not null, default: 'INITIALIZED', note: 'INITIALIZED, ACTIVE, PAUSED, COMPLETED, ARCHIVED']
  start_date date
  target_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Structured learning roadmap aggregate root'
}

Table milestones {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  sequence_order integer [not null]
  title varchar(255) [not null]
  description text
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, IN_PROGRESS, COMPLETED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Curricular milestones (Tier-1 decomposition)'
}

Table official_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, unique, ref: - roadmaps.id]
  total_sessions integer [not null, default: 0]
  total_planned_minutes integer [not null, default: 0]
  activated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Approved frozen schedule baseline'
}

Table schedule_proposals {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  user_id uuid [not null, ref: > users.id]
  proposal_data jsonb [not null]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, APPLIED, REJECTED']
  applied_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'AI generated schedule draft prior to learner approval'
}

// ============================================================================
// BOUNDED CONTEXT 3: EXECUTION (5 TABLES)
// ============================================================================

Table tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  milestone_id uuid [not null, ref: > milestones.id]
  official_schedule_id uuid [ref: > official_schedules.id]
  title varchar(255) [not null]
  description text
  estimated_minutes integer [not null]
  scheduled_date date
  scheduled_start timestamptz
  scheduled_end timestamptz
  status varchar(20) [not null, default: 'TODO', note: 'TODO, IN_PROGRESS, COMPLETED, CANCELLED']
  completed_at timestamptz
  reschedule_count integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Actionable micro-learning unit'
}

Table task_dependencies {
  id uuid [pk, default: `gen_random_uuid()`]
  predecessor_id uuid [not null, ref: > tasks.id]
  successor_id uuid [not null, ref: > tasks.id]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  is_mandatory boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Directed Acyclic Graph (DAG) task prerequisites'
}

Table study_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  planned_minutes integer [not null]
  actual_minutes integer [not null, default: 0]
  status varchar(20) [not null, default: 'IN_PROGRESS', note: 'IN_PROGRESS, COMPLETED, ABANDONED']
  last_heartbeat_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Pomodoro or Stopwatch study session execution unit'
}

Table session_tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null, ref: > study_sessions.id]
  task_id uuid [not null, ref: > tasks.id]
  allocated_minutes integer [not null, default: 0]
  actual_minutes integer [not null, default: 0]
  status_after_session varchar(20) [not null, default: 'IN_PROGRESS', note: 'IN_PROGRESS, COMPLETED, BLOCKED']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Association entity linking sessions to executed tasks'
}

Table study_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  session_id uuid [ref: > study_sessions.id]
  task_id uuid [ref: > tasks.id]
  note_type varchar(20) [not null, note: 'SCRATCHPAD, KEY_TAKEAWAY, REFLECTION']
  content text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Learner markdown notes and reflection takeaways'
}

// ============================================================================
// BOUNDED CONTEXT 4: EVALUATION & ADAPTATION (3 TABLES)
// ============================================================================

Table pause_records {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  pause_start_date date [not null]
  pause_end_date date [not null]
  shifted_days integer [not null]
  reason text
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, RESUMED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Roadmap pause intervals and Domino Shift ledger'
}

Table ai_reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  user_id uuid [not null, ref: > users.id]
  milestone_id uuid [ref: > milestones.id]
  review_cycle varchar(20) [not null, note: 'WEEKLY, MILESTONE_END']
  period_start date
  period_end date
  quantitative_summary jsonb [not null, default: '{}']
  strengths_feedback text [not null]
  bottlenecks_feedback text [not null]
  action_recommendations text [not null]
  model_used varchar(100) [not null]
  generated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Periodic AI pedagogical feedback based on Zimmerman SRL'
}

Table schedule_change_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  roadmap_id uuid [not null, ref: > roadmaps.id]
  schedule_id uuid [ref: > official_schedules.id]
  task_id uuid [ref: > tasks.id]
  trigger_type varchar(30) [not null, note: 'DOMINO_SHIFT, MANUAL_DRAG, AI_RESCHEDULE, OVERDUE_AUTO']
  reason text
  affected_tasks_count integer [not null, default: 1]
  total_shifted_minutes integer [not null, default: 0]
  diff_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Audit log of schedule mutations and shifts'
}

// ============================================================================
// SHARED KERNEL: TRANSACTIONAL INFRASTRUCTURE (2 TABLES)
// ============================================================================

Table outbox_events {
  id uuid [pk, default: `gen_random_uuid()`]
  aggregate_type varchar(100) [not null]
  aggregate_id uuid [not null]
  event_type varchar(120) [not null]
  payload jsonb [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, PUBLISHED, FAILED']
  retry_count integer [not null, default: 0]
  correlation_id varchar(64)
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  Note: 'Transactional Outbox pattern for guaranteed at-least-once event delivery'
}

Table processed_events {
  event_id uuid [not null, ref: > outbox_events.id]
  handler_name varchar(120) [not null]
  processed_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, handler_name) [pk]
  }

  Note: 'Idempotent consumer ledger preventing duplicate handler execution'
}

// ============================================================================
// TABLE GROUPS FOR DBMGRAPH / DBDATAGROUP VISUALIZATION
// ============================================================================

TableGroup AccountContext {
  users
  learner_profiles
  webcal_tokens
  availabilities
  availability_slots
  ai_quotas
  ai_quota_reservations
  ai_usage_logs
  payment_transactions
}

TableGroup PlanningContext {
  goals
  roadmaps
  milestones
  official_schedules
  schedule_proposals
}

TableGroup ExecutionContext {
  tasks
  task_dependencies
  study_sessions
  session_tasks
  study_notes
}

TableGroup EvaluationContext {
  pause_records
  ai_reviews
  schedule_change_logs
}

TableGroup SharedKernel {
  outbox_events
  processed_events
}
