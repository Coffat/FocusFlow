@startuml FocusFlow_UseCase_Diagram
title FocusFlow — Sơ đồ Ca sử dụng Tổng quan Hệ thống (System Overview Across 5 Bounded Context Packages)

left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam nodesep 25
skinparam ranksep 60

skinparam actor {
    BackgroundColor #EBF8FF
    BorderColor #2B6CB0
    FontColor #1A202C
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #4A5568
    FontColor #1A202C
}

skinparam package {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #2D3748
    FontStyle bold
}

skinparam rectangle<<system>> {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
}

' ========================================================
' 1. TÁC NHÂN KHỞI XƯỚNG (PRIMARY ACTORS - BÊN TRÁI)
' ========================================================
actor "Người dùng đã xác thực\n(Authenticated User)" as AuthUser #E2E8F0
actor "ACT-01: Người học\n(Learner)" as Learner #EBF8FF
actor "ACT-02: Quản trị viên hệ thống\n(Administrator)" as Admin #FEFCBF
actor "ACT-03: Bộ lập lịch hệ thống\n(System Scheduler)" as Scheduler <<system>> #E6FFFA

Learner --|> AuthUser
Admin --|> AuthUser

' ========================================================
' 2. RANH GIỚI HỆ THỐNG (SYSTEM UNDER DESIGN - SuD)
' ========================================================
rectangle "Hệ thống FocusFlow (System Under Design - SuD)" as FocusFlowSystem {

    ' PHÂN HỆ 1: QUẢN LÝ TÀI KHOẢN, HỒ SƠ & GÓI DỊCH VỤ
    package "Phân hệ 1: Quản lý Tài khoản, Hồ sơ & Gói dịch vụ (UC-01..UC-06)" as Mod1 {
        usecase "UC-01\nĐăng ký tài khoản" as UC01
        usecase "UC-02\nĐăng nhập và Quản lý\nphiên xác thực" as UC02
        usecase "UC-03\nQuản lý hồ sơ cá nhân\nvà Thời gian rảnh" as UC03
        usecase "UC-04\nNâng cấp gói dịch vụ\nPremium" as UC04
        usecase "UC-05\nXử lý thông báo kết quả\nthanh toán (Webhook)" as UC05
        usecase "UC-06\nLàm mới hạn ngạch định kỳ\nvà Thu hồi giữ chỗ quá hạn" as UC06
    }

    ' PHÂN HỆ 2: KHỞI TẠO & LẬP KẾ HOẠCH LỘ TRÌNH
    package "Phân hệ 2: Khởi tạo & Lập kế hoạch Lộ trình (UC-07..UC-12)" as Mod2 {
        usecase "UC-07\nKhởi tạo mục tiêu và Tạo\nkhung lộ trình bằng AI" as UC07
        usecase "UC-08\nSinh lịch học đề xuất bằng AI\nvà Phê duyệt" as UC08
        usecase "UC-09\nTạo và Lập lịch\nlộ trình thủ công" as UC09
        usecase "UC-10\nQuản lý danh mục lộ trình\nvà Lưu trữ" as UC10
        usecase "UC-11\nQuản lý công việc học tập\nvà Quan hệ tiên quyết" as UC11
        usecase "UC-12\nKiểm định tính hợp lệ\ncủa lịch học" as UC12
    }

    ' PHÂN HỆ 3: THỰC THI HỌC TẬP & TÍCH HỢP LỊCH NGOẠI VI
    package "Phân hệ 3: Thực thi Học tập & Tích hợp Lịch ngoại vi (UC-13..UC-17)" as Mod3 {
        usecase "UC-13\nXem lịch học và Dời lịch\ncông việc thủ công" as UC13
        usecase "UC-14\nThực hiện phiên học tập trung\nvà Ghi chú" as UC14
        usecase "UC-15\nTự động chốt phiên học\nbị gián đoạn" as UC15
        usecase "UC-16\nKết nối và Đồng bộ khoảng bận\ntừ lịch ngoại vi" as UC16
        usecase "UC-17\nXuất lịch học .ics và\nQuản lý liên kết WebCal" as UC17
    }

    ' PHÂN HỆ 4: PHÂN TÍCH TIẾN ĐỘ & THÍCH ỨNG LỊCH TRÌNH
    package "Phân hệ 4: Phân tích Tiến độ & Thích ứng Lịch trình (UC-18..UC-22)" as Mod4 {
        usecase "UC-18\nXem báo cáo thống kê\ntiến độ học tập\n---\nextension points:\nAI Deep Evaluation Request" as UC18
        usecase "UC-19\nYêu cầu AI đánh giá chuyên sâu\nvà Gợi ý điều chỉnh" as UC19
        usecase "UC-20\nTạm dừng và Tiếp tục\nlộ trình học tập (Domino Shift)" as UC20
        usecase "UC-21\nDời lịch bằng AI\ncho bài học quá hạn" as UC21
        usecase "UC-22\nQuét công việc quá hạn, Tổng hợp\nhồ sơ thói quen và Gửi thông báo" as UC22
    }

    ' PHÂN HỆ 5: QUẢN TRỊ HỆ THỐNG
    package "Phân hệ 5: Quản trị Hệ thống (UC-23..UC-25)" as Mod5 {
        usecase "UC-23\nQuản lý tài khoản và\nHạn ngạch người dùng" as UC23
        usecase "UC-24\nĐối soát giao dịch\nthanh toán" as UC24
        usecase "UC-25\nGiám sát tình trạng vận hành\nhệ thống và dịch vụ AI" as UC25
    }
}

' ========================================================
' 3. TÁC NHÂN HỆ THỐNG NGOẠI VI (EXTERNAL SYSTEM ACTORS - BÊN PHẢI)
' ========================================================
rectangle "ACT-04: Nhà cung cấp dịch vụ LLM\n(External LLM Provider)" as LLM <<system>>
rectangle "ACT-05: Dịch vụ Lịch ngoại vi\n(External Calendar Service)" as CalService <<system>>
rectangle "ACT-06: Cổng thanh toán\n(Payment Gateway)" as PayGateway <<system>>
rectangle "ACT-07: Dịch vụ Email\n(Email Notification Service)" as EmailService <<system>>

' ========================================================
' 4. QUAN HỆ VỚI TÁC NHÂN CHÍNH (PRIMARY ASSOCIATIONS)
' ========================================================
AuthUser -- UC02

Learner -- UC01
Learner -- UC03
Learner -- UC04

Learner -- UC07
Learner -- UC08
Learner -- UC09
Learner -- UC10
Learner -- UC11

Learner -- UC13
Learner -- UC14
Learner -- UC16
Learner -- UC17

Learner -- UC18
Learner -- UC19
Learner -- UC20
Learner -- UC21

Admin -- UC23
Admin -- UC24
Admin -- UC25

Scheduler -- UC06
Scheduler -- UC15
Scheduler -- UC22

PayGateway -- UC05

' ========================================================
' 5. QUAN HỆ NỘI BỘ GIỮA CÁC USE CASE (<<include>> & <<extend>>)
' ========================================================
UC08 ..> UC12 : <<include>>
UC09 ..> UC12 : <<include>>
UC11 ..> UC12 : <<include>>
UC13 ..> UC12 : <<include>>
UC20 ..> UC12 : <<include>>
UC21 ..> UC12 : <<include>>

UC19 ..> UC18 : <<extend>>\n[Yêu cầu đánh giá chuyên sâu]

' ========================================================
' 6. QUAN HỆ VỚI TÁC NHÂN PHỤ TRỢ (SECONDARY ASSOCIATIONS)
' ========================================================
UC04 -- PayGateway
UC24 -- PayGateway

UC07 -- LLM
UC08 -- LLM
UC14 -- LLM
UC19 -- LLM
UC21 -- LLM

UC16 -- CalService
UC17 -- CalService

UC22 -- EmailService

@enduml
