@startuml FocusFlow_UseCase_Diagram
' ========================================================
' Chuẩn hóa 8 Tác nhân (ACT-00..ACT-07): 4 Human/Role Actors + 4 External System Actors
' Tuân thủ nghiêm ngặt OMG UML 2.5.1 Clause 18: Các thành phần nội bộ (Taskiq, Redis, DB,
' AI Harness) và bộ định thời nội bộ (internal clock triggers) nằm bên trong Ranh giới Hệ thống.
' ========================================================
title FocusFlow — Sơ đồ Ca sử dụng Tổng quan Hệ thống (System Overview Across 5 Bounded Context Packages — 47 Core Use Cases)

left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam nodesep 22
skinparam ranksep 60

skinparam actor {
    BackgroundColor #EBF8FF
    BorderColor #2B6CB0
    FontColor #1A202C
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #4A5568
    FontColor #1A202C
}

skinparam package {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #2D3748
    FontStyle bold
}

skinparam rectangle<<system>> {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
}

' ========================================================
' 1. TÁC NHÂN CON NGƯỜI / VAI TRÒ (HUMAN / ROLE ACTORS - BÊN TRÁI)
' ========================================================
actor "ACT-00: Khách vãng lai\n(Guest / Anonymous User)" as Guest #EDF2F7
actor "ACT-01: Người dùng đã đăng ký\n(Registered User)" as RegUser #E2E8F0
actor "ACT-02: Người học\n(Learner)" as Learner #EBF8FF
actor "ACT-03: Quản trị viên hệ thống\n(Administrator)" as Admin #FEFCBF

' Kế thừa tác nhân
Learner --|> RegUser
Admin --|> RegUser

' ========================================================
' 2. RANH GIỚI HỆ THỐNG (SYSTEM UNDER DESIGN - SuD)
' ========================================================
rectangle "Hệ thống FocusFlow — Adaptive Self-Learning Operating System (System Under Design - SuD)" as FocusFlowSystem {

    ' PHÂN HỆ 1: QUẢN LÝ TÀI KHOẢN, HỒ SƠ & GÓI DỊCH VỤ (11 UCs)
    package "Phân hệ 1: Quản lý Tài khoản, Hồ sơ & Gói dịch vụ (11 UCs)" as Mod1 {
        usecase "UC-ACC-01\nĐăng ký tài khoản" as UC_ACC_01
        usecase "UC-ACC-02\nĐăng nhập" as UC_ACC_02
        usecase "UC-ACC-03\nĐặt lại mật khẩu" as UC_ACC_03
        usecase "UC-ACC-04\nCấu hình hồ sơ và\nthời gian rảnh" as UC_ACC_04
        usecase "UC-ACC-05\nXóa tài khoản" as UC_ACC_05
        usecase "UC-ACC-06\nNâng cấp hoặc gia hạn\ngói Premium" as UC_ACC_06
        usecase "UC-ACC-07\nXử lý thông báo kết quả\nthanh toán (Webhook)" as UC_ACC_07
        usecase "UC-ACC-08\nDọn bản ghi giữ chỗ và\nđơn thanh toán treo" as UC_ACC_08
        usecase "UC-ACC-09\nLàm mới hạn ngạch\nchu kỳ tháng" as UC_ACC_09
        usecase "UC-ACC-10\nHạ cấp gói dịch vụ\nhết hạn" as UC_ACC_10
        usecase "UC-ACC-11\nQuản lý ghi chú\nthói quen học tập" as UC_ACC_11
    }

    ' PHÂN HỆ 2: KHỞI TẠO & LẬP KẾ HOẠCH LỘ TRÌNH (10 UCs)
    package "Phân hệ 2: Khởi tạo & Lập kế hoạch Lộ trình (10 UCs)" as Mod2 {
        usecase "UC-PLAN-01\nTạo khung lộ trình\nbằng AI" as UC_PLAN_01
        usecase "UC-PLAN-02\nTạo danh sách bài học\nbằng AI" as UC_PLAN_02
        usecase "UC-PLAN-03\nXếp lịch học bằng AI\nvà áp dụng" as UC_PLAN_03
        usecase "UC-PLAN-04\nTạo lộ trình thủ công" as UC_PLAN_04
        usecase "UC-PLAN-05\nCập nhật thông tin\nlộ trình" as UC_PLAN_05
        usecase "UC-PLAN-06\nLưu trữ lộ trình" as UC_PLAN_06
        usecase "UC-PLAN-07\nQuản lý công việc và\nquan hệ tiên quyết" as UC_PLAN_07
        usecase "UC-PLAN-08\nQuản lý cột mốc" as UC_PLAN_08
        usecase "UC-PLAN-09\nKiểm định tính hợp lệ\ncủa lịch học" as UC_PLAN_09 <<subfunction>> #F7FAFC
        usecase "UC-PLAN-10\nMô phỏng kịch bản giả định\n(What-if Simulation)" as UC_PLAN_10
    }

    ' PHÂN HỆ 3: THỰC THI HỌC TẬP & TÍCH HỢP LỊCH NGOẠI VI (9 UCs)
    package "Phân hệ 3: Thực thi Học tập & Tích hợp Lịch ngoại vi (9 UCs)" as Mod3 {
        usecase "UC-EXEC-01\nXem lịch học và\nTiêu điểm Hôm nay" as UC_EXEC_01
        usecase "UC-EXEC-02\nDời lịch công việc\nthủ công" as UC_EXEC_02
        usecase "UC-EXEC-03\nĐánh dấu hoàn thành\nnhanh" as UC_EXEC_03
        usecase "UC-EXEC-04\nThực hiện phiên học tập trung\n(Tiêu chuẩn & Rút gọn)" as UC_EXEC_04
        usecase "UC-EXEC-05\nChia nhỏ bài học\nbằng AI" as UC_EXEC_05
        usecase "UC-EXEC-06\nTự động lưu phiên học\nkhi mất kết nối" as UC_EXEC_06
        usecase "UC-EXEC-07\nKết nối tài khoản\nGoogle Calendar" as UC_EXEC_07
        usecase "UC-EXEC-08\nTự động cập nhật thời gian bận\ntừ Google Calendar" as UC_EXEC_08
        usecase "UC-EXEC-09\nĐồng bộ lịch học sang\nGoogle Calendar / ứng dụng lịch" as UC_EXEC_09
    }

    ' PHÂN HỆ 4: PHÂN TÍCH TIẾN ĐỘ, KIỂM CHỨNG NĂNG LỰC & THÍCH ỨNG LỊCH TRÌNH (10 UCs)
    package "Phân hệ 4: Phân tích Tiến độ, Kiểm chứng Năng lực & Thích ứng Lịch trình (10 UCs)" as Mod4 {
        usecase "UC-ADAPT-01\nXem báo cáo tiến độ và\nbằng chứng học tập" as UC_ADAPT_01
        usecase "UC-ADAPT-02\nLàm bài kiểm tra cột mốc" as UC_ADAPT_02
        usecase "UC-ADAPT-03\nĐánh giá học tập\ncuối tuần" as UC_ADAPT_03
        usecase "UC-ADAPT-04\nTạm dừng lộ trình" as UC_ADAPT_04
        usecase "UC-ADAPT-05\nTiếp tục lộ trình và\ndời lịch bù ngày dừng" as UC_ADAPT_05
        usecase "UC-ADAPT-06\nDời lịch bằng AI cho\nbài quá hạn" as UC_ADAPT_06
        usecase "UC-ADAPT-07\nKhôi phục lộ trình\nbị gián đoạn lâu ngày" as UC_ADAPT_07
        usecase "UC-ADAPT-08\nGửi email nhắc nhở bài quá hạn\nvà lộ trình gián đoạn" as UC_ADAPT_08
        usecase "UC-ADAPT-09\nTổng hợp hồ sơ\nthói quen học tập" as UC_ADAPT_09
        usecase "UC-ADAPT-10\nĐặt lại ngân sách\ndời lịch hàng tuần" as UC_ADAPT_10
    }

    ' PHÂN HỆ 5: QUẢN TRỊ HỆ THỐNG (7 UCs)
    package "Phân hệ 5: Quản trị Hệ thống (7 UCs)" as Mod5 {
        usecase "UC-ADM-01\nKhóa hoặc mở khóa\ntài khoản người dùng" as UC_ADM_01
        usecase "UC-ADM-02\nĐổi gói dịch vụ\ncủa người dùng" as UC_ADM_02
        usecase "UC-ADM-03\nĐiều chỉnh hạn ngạch\nAI người dùng" as UC_ADM_03
        usecase "UC-ADM-04\nĐối soát đơn thanh toán" as UC_ADM_04
        usecase "UC-ADM-05\nGiám sát vận hành hệ thống\nvà dịch vụ AI" as UC_ADM_05
        usecase "UC-ADM-06\nXem nhật ký kiểm toán\nquản trị" as UC_ADM_06
        usecase "UC-ADM-07\nQuản lý kho khái niệm\ntri thức" as UC_ADM_07
    }
}

' ========================================================
' 3. TÁC NHÂN HỆ THỐNG NGOẠI VI (EXTERNAL SYSTEM ACTORS - BÊN PHẢI)
' ========================================================
rectangle "ACT-04: Nhà cung cấp dịch vụ LLM\n(External LLM Provider)" as LLM <<system>>
rectangle "ACT-05: Cổng thanh toán\n(Payment Gateway)" as PayGateway <<system>>
rectangle "ACT-06: Dịch vụ Lịch ngoại vi\n(External Calendar Service)" as ExtCal <<system>>
rectangle "ACT-07: Dịch vụ Email\n(Email Notification Service)" as EmailSvc <<system>>

' ========================================================
' 4. QUAN HỆ VỚI TÁC NHÂN CHÍNH & THỤ HƯỞNG (PRIMARY / BENEFICIARY ASSOCIATIONS)
' ========================================================
' Khách vãng lai
Guest -- UC_ACC_01

' Người dùng đã đăng ký
RegUser -- UC_ACC_02
RegUser -- UC_ACC_03

' Người học (Learner)
Learner -- UC_ACC_04
Learner -- UC_ACC_05
Learner -- UC_ACC_06
Learner -- UC_ACC_08
Learner -- UC_ACC_09
Learner -- UC_ACC_10
Learner -- UC_ACC_11

Learner -- UC_PLAN_01
Learner -- UC_PLAN_02
Learner -- UC_PLAN_03
Learner -- UC_PLAN_04
Learner -- UC_PLAN_05
Learner -- UC_PLAN_06
Learner -- UC_PLAN_07
Learner -- UC_PLAN_08
Learner -- UC_PLAN_10

Learner -- UC_EXEC_01
Learner -- UC_EXEC_02
Learner -- UC_EXEC_03
Learner -- UC_EXEC_04
Learner -- UC_EXEC_05
Learner -- UC_EXEC_06
Learner -- UC_EXEC_07
Learner -- UC_EXEC_08
Learner -- UC_EXEC_09

Learner -- UC_ADAPT_01
Learner -- UC_ADAPT_02
Learner -- UC_ADAPT_03
Learner -- UC_ADAPT_04
Learner -- UC_ADAPT_05
Learner -- UC_ADAPT_06
Learner -- UC_ADAPT_07
Learner -- UC_ADAPT_08
Learner -- UC_ADAPT_09
Learner -- UC_ADAPT_10

' Quản trị viên (Administrator)
Admin -- UC_ACC_08
Admin -- UC_ADM_01
Admin -- UC_ADM_02
Admin -- UC_ADM_03
Admin -- UC_ADM_04
Admin -- UC_ADM_05
Admin -- UC_ADM_06
Admin -- UC_ADM_07

' Cổng thanh toán (Webhook chủ động)
PayGateway -- UC_ACC_07

' ========================================================
' 5. QUAN HỆ NỘI BỘ GIỮA CÁC USE CASE (<<include>>)
' ========================================================
UC_PLAN_03 ..> UC_PLAN_09 : <<include>>
UC_PLAN_04 ..> UC_PLAN_09 : <<include>>
UC_PLAN_07 ..> UC_PLAN_09 : <<include>>
UC_PLAN_10 ..> UC_PLAN_09 : <<include>>
UC_EXEC_02 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_04 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_05 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_06 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_07 ..> UC_PLAN_09 : <<include>>

' ========================================================
' 6. QUAN HỆ VỚI TÁC NHÂN PHỤ TRỢ (SECONDARY ASSOCIATIONS)
' ========================================================
UC_ACC_06 -- PayGateway
UC_ADM_04 -- PayGateway

UC_PLAN_01 -- LLM
UC_PLAN_02 -- LLM
UC_PLAN_03 -- LLM
UC_EXEC_04 -- LLM
UC_EXEC_05 -- LLM
UC_ADAPT_02 -- LLM
UC_ADAPT_03 -- LLM
UC_ADAPT_06 -- LLM
UC_ADAPT_07 -- LLM

UC_EXEC_07 -- ExtCal
UC_EXEC_08 -- ExtCal
UC_EXEC_09 -- ExtCal

UC_ACC_01 -- EmailSvc
UC_ACC_03 -- EmailSvc
UC_ADAPT_08 -- EmailSvc

@enduml
