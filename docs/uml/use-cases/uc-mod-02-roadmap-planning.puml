@startuml uc-mod-02-roadmap-planning
title FocusFlow — Phân hệ 2: Khởi tạo & Lập kế hoạch Lộ trình (UC-07..UC-12)

left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam nodesep 40
skinparam ranksep 75

skinparam actor {
    BackgroundColor #EBF8FF
    BorderColor #2B6CB0
    FontColor #1A202C
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #4A5568
    FontColor #1A202C
}

skinparam package {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #2D3748
    FontStyle bold
}

skinparam rectangle<<system>> {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
}

' 1. TÁC NHÂN CHÍNH (PRIMARY ACTOR - BÊN TRÁI)
actor "ACT-01: Người học\n(Learner)" as Learner #EBF8FF

' 2. RANH GIỚI HỆ THỐNG (SYSTEM BOUNDARY)
rectangle "Hệ thống FocusFlow — Phân hệ 2: Khởi tạo & Lập kế hoạch Lộ trình" as Mod2Boundary {
    usecase "UC-07\nKhởi tạo mục tiêu và Tạo\nkhung lộ trình bằng AI" as UC07
    usecase "UC-08\nSinh lịch học đề xuất bằng AI\nvà Phê duyệt" as UC08
    usecase "UC-09\nTạo và Lập lịch\nlộ trình thủ công" as UC09
    usecase "UC-10\nQuản lý danh mục lộ trình\nvà Lưu trữ" as UC10
    usecase "UC-11\nQuản lý công việc học tập\nvà Quan hệ tiên quyết" as UC11
    usecase "UC-12\nKiểm định tính hợp lệ\ncủa lịch học" as UC12
}

' 3. TÁC NHÂN HỆ THỐNG PHỤ TRỢ (SUPPORTING SYSTEM ACTOR - BÊN PHẢI)
rectangle "ACT-04: Nhà cung cấp dịch vụ LLM\n(External LLM Provider)" as LLM <<system>>

' 4. QUAN HỆ (ASSOCIATIONS & INCLUDE)
Learner -- UC07
Learner -- UC08
Learner -- UC09
Learner -- UC10
Learner -- UC11

UC08 ..> UC12 : <<include>>
UC09 ..> UC12 : <<include>>
UC11 ..> UC12 : <<include>>

UC07 -- LLM
UC08 -- LLM

@enduml
