@startuml uc-mod-01-account-profile-billing
title FocusFlow — Phân hệ 1: Quản lý Tài khoản, Hồ sơ & Gói dịch vụ (UC-01..UC-06)

left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam nodesep 40
skinparam ranksep 75

skinparam actor {
    BackgroundColor #EBF8FF
    BorderColor #2B6CB0
    FontColor #1A202C
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #4A5568
    FontColor #1A202C
}

skinparam package {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #2D3748
    FontStyle bold
}

skinparam rectangle<<system>> {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
}

' 1. TÁC NHÂN CHÍNH (PRIMARY ACTORS - BÊN TRÁI)
actor "Người dùng đã xác thực\n(Authenticated User)" as AuthUser #E2E8F0
actor "ACT-01: Người học\n(Learner)" as Learner #EBF8FF
actor "ACT-02: Quản trị viên hệ thống\n(Administrator)" as Admin #FEFCBF
actor "ACT-03: Bộ lập lịch hệ thống\n(System Scheduler)" as Scheduler <<system>> #E6FFFA

Learner --|> AuthUser
Admin --|> AuthUser

' 2. RANH GIỚI HỆ THỐNG (SYSTEM BOUNDARY)
rectangle "Hệ thống FocusFlow — Phân hệ 1: Quản lý Tài khoản, Hồ sơ & Gói dịch vụ" as Mod1Boundary {
    usecase "UC-01\nĐăng ký tài khoản" as UC01
    usecase "UC-02\nĐăng nhập và Quản lý\nphiên xác thực" as UC02
    usecase "UC-03\nQuản lý hồ sơ cá nhân\nvà Thời gian rảnh" as UC03
    usecase "UC-04\nNâng cấp gói dịch vụ Premium" as UC04
    usecase "UC-05\nXử lý thông báo kết quả\nthanh toán (Webhook)" as UC05
    usecase "UC-06\nLàm mới hạn ngạch định kỳ và\nThu hồi giữ chỗ quá hạn" as UC06
}

' 3. TÁC NHÂN HỆ THỐNG NGOẠI VI (EXTERNAL SYSTEM ACTORS - BÊN PHẢI)
rectangle "ACT-06: Cổng thanh toán\n(Payment Gateway)" as PayGateway <<system>>

' 4. QUAN HỆ GIAO TIẾP (ASSOCIATIONS)
Learner -- UC01
AuthUser -- UC02
Learner -- UC03
Learner -- UC04

UC04 -- PayGateway
PayGateway -- UC05

Scheduler -- UC06

@enduml
