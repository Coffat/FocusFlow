@startuml uc-mod-04-analytics-adaptation
title FocusFlow — Phân hệ 4: Phân tích Tiến độ & Thích ứng Lịch trình (UC-18..UC-22)

left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam nodesep 40
skinparam ranksep 75

skinparam actor {
    BackgroundColor #EBF8FF
    BorderColor #2B6CB0
    FontColor #1A202C
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #4A5568
    FontColor #1A202C
}

skinparam package {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #2D3748
    FontStyle bold
}

skinparam rectangle<<system>> {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
}

' 1. TÁC NHÂN CHÍNH (PRIMARY ACTORS - BÊN TRÁI)
actor "ACT-01: Người học\n(Learner)" as Learner #EBF8FF
actor "ACT-03: Bộ lập lịch hệ thống\n(System Scheduler)" as Scheduler <<system>> #E6FFFA

' 2. RANH GIỚI HỆ THỐNG (SYSTEM BOUNDARY)
rectangle "Hệ thống FocusFlow — Phân hệ 4: Phân tích Tiến độ & Thích ứng Lịch trình" as Mod4Boundary {
    usecase "UC-18\nXem báo cáo thống kê\ntiến độ học tập\n---\nextension points:\nAI Deep Evaluation Request" as UC18
    usecase "UC-19\nYêu cầu AI đánh giá chuyên sâu\nvà Gợi ý điều chỉnh" as UC19
    usecase "UC-20\nTạm dừng và Tiếp tục\nlộ trình học tập (Domino Shift)" as UC20
    usecase "UC-21\nDời lịch bằng AI\ncho bài học quá hạn" as UC21
    usecase "UC-22\nQuét công việc quá hạn, Tổng hợp\nhồ sơ thói quen và Gửi thông báo" as UC22
    usecase "UC-12\nKiểm định tính hợp lệ\ncủa lịch học" as UC12 <<subfunction>> #F7FAFC
}

' 3. TÁC NHÂN HỆ THỐNG PHỤ TRỢ (SUPPORTING SYSTEM ACTORS - BÊN PHẢI)
rectangle "ACT-04: Nhà cung cấp dịch vụ LLM\n(External LLM Provider)" as LLM <<system>>
rectangle "ACT-07: Dịch vụ Email\n(Email Notification Service)" as EmailService <<system>>

' 4. QUAN HỆ (ASSOCIATIONS, INCLUDE & EXTEND)
Learner -- UC18
Learner -- UC19
Learner -- UC20
Learner -- UC21

Scheduler -- UC22

UC19 ..> UC18 : <<extend>>\n[Yêu cầu đánh giá chuyên sâu]

UC20 ..> UC12 : <<include>>
UC21 ..> UC12 : <<include>>

UC19 -- LLM
UC21 -- LLM
UC22 -- EmailService

@enduml
