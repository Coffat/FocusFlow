@startuml uc-mod-04-analytics-adaptation
' ========================================================
' Chuẩn hóa 8 Tác nhân (ACT-00..ACT-07): 4 Human/Role Actors + 4 External System Actors
' Tuân thủ nghiêm ngặt OMG UML 2.5.1 Clause 18: Các thành phần nội bộ (Taskiq, Redis, DB,
' AI Harness) và bộ định thời nội bộ (internal clock triggers) nằm bên trong Ranh giới Hệ thống.
' ========================================================
title FocusFlow — Phân hệ 4: Phân tích Tiến độ, Kiểm chứng Năng lực & Thích ứng Lịch trình (10 Use Cases)

left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam nodesep 35
skinparam ranksep 70

skinparam actor {
    BackgroundColor #EBF8FF
    BorderColor #2B6CB0
    FontColor #1A202C
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #4A5568
    FontColor #1A202C
}

skinparam package {
    BackgroundColor #F7FAFC
    BorderColor #CBD5E0
    FontColor #2D3748
    FontStyle bold
}

skinparam rectangle<<system>> {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
}

' ========================================================
' 1. TÁC NHÂN CON NGƯỜI / VAI TRÒ (HUMAN / ROLE ACTOR - BÊN TRÁI)
' ========================================================
actor "ACT-02: Người học\n(Learner)" as Learner #EBF8FF

' ========================================================
' 2. RANH GIỚI HỆ THỐNG (SYSTEM BOUNDARY)
' ========================================================
rectangle "Hệ thống FocusFlow — Phân hệ 4: Phân tích Tiến độ, Kiểm chứng Năng lực & Thích ứng Lịch trình" as Mod4Boundary {
    usecase "UC-ADAPT-01\nXem báo cáo tiến độ và\nbằng chứng học tập" as UC_ADAPT_01
    usecase "UC-ADAPT-02\nLàm bài kiểm tra cột mốc" as UC_ADAPT_02
    usecase "UC-ADAPT-03\nĐánh giá học tập\ncuối tuần" as UC_ADAPT_03
    usecase "UC-ADAPT-04\nTạm dừng lộ trình" as UC_ADAPT_04
    usecase "UC-ADAPT-05\nTiếp tục lộ trình và\ndời lịch bù ngày dừng" as UC_ADAPT_05
    usecase "UC-ADAPT-06\nDời lịch bằng AI cho\nbài quá hạn" as UC_ADAPT_06
    usecase "UC-ADAPT-07\nKhôi phục lộ trình\nbị gián đoạn lâu ngày" as UC_ADAPT_07
    usecase "UC-ADAPT-08\nGửi email nhắc nhở bài quá hạn\nvà lộ trình gián đoạn" as UC_ADAPT_08
    usecase "UC-ADAPT-09\nTổng hợp hồ sơ\nthói quen học tập" as UC_ADAPT_09
    usecase "UC-ADAPT-10\nĐặt lại ngân sách\ndời lịch hàng tuần" as UC_ADAPT_10
    usecase "UC-PLAN-09\nKiểm định tính hợp lệ\ncủa lịch học" as UC_PLAN_09 <<subfunction>> #F7FAFC
}

' ========================================================
' 3. TÁC NHÂN HỆ THỐNG NGOẠI VI (EXTERNAL SYSTEM ACTORS - BÊN PHẢI)
' ========================================================
rectangle "ACT-04: Nhà cung cấp dịch vụ LLM\n(External LLM Provider)" as LLM <<system>>
rectangle "ACT-07: Dịch vụ Email\n(Email Notification Service)" as EmailSvc <<system>>

' ========================================================
' 4. QUAN HỆ GIAO TIẾP (ASSOCIATIONS & INCLUDE)
' ========================================================
Learner -- UC_ADAPT_01
Learner -- UC_ADAPT_02
Learner -- UC_ADAPT_03
Learner -- UC_ADAPT_04
Learner -- UC_ADAPT_05
Learner -- UC_ADAPT_06
Learner -- UC_ADAPT_07
Learner -- UC_ADAPT_08
Learner -- UC_ADAPT_09
Learner -- UC_ADAPT_10

UC_ADAPT_04 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_05 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_06 ..> UC_PLAN_09 : <<include>>
UC_ADAPT_07 ..> UC_PLAN_09 : <<include>>

UC_ADAPT_02 -- LLM
UC_ADAPT_03 -- LLM
UC_ADAPT_06 -- LLM
UC_ADAPT_07 -- LLM

UC_ADAPT_08 -- EmailSvc

@enduml
