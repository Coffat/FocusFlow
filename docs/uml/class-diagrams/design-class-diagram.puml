@startuml FocusFlow_Design_Class_Diagram
title FocusFlow — Sơ đồ Lớp Thiết kế Chi tiết (Design Class Diagram - DCD)
' Phiên bản: v3.3 — 19 Lớp Thực thể Thiết kế (Chuẩn Rich Domain Model, 100% Lớp là Danh từ theo GRASP Information Expert)

skinparam roundcorner 10
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #2D3748
    FontStyle bold
}

skinparam enum {
    BackgroundColor #FFF5F5
    BorderColor #C53030
}

' ========================================================
' 1. CÁC LỚP THỰC THỂ THIẾT KẾ (DESIGN ENTITY CLASSES - 19 THỰC THỂ)
' Chuẩn Encapsulation: Thuộc tính private (-), Phương thức public (+)
' ========================================================

class User {
    - id: UUID
    - fullName: String
    - email: String
    - timezone: String
    - role: UserRole
    - tier: UserTier
    --
    + canUseAI(): Boolean
    + isFreeTier(): Boolean
    + upgradeTier(newTier: UserTier): void
}

class Goal {
    - id: UUID
    - title: String
    - targetDate: Date
    - context: String
    - status: GoalStatus
    --
    + getDaysRemaining(): Integer
    + sanitizeContext(): void
    + archive(): void
}

class Roadmap {
    - id: UUID
    - title: String
    - startDate: Date
    - targetDate: Date
    - status: RoadmapStatus
    --
    + activate(): void
    + applyOfficialSchedule(schedule: OfficialSchedule): void
    + pause(startDate: Date, endDate: Date, reason: String): void
    + resume(): void
    + calculateDominoShift(pauseRecord: PauseRecord): void
    + archive(): void
}

class OfficialSchedule {
    - id: UUID
    - totalSessions: Integer
    - totalPlannedMinutes: Integer
    - activatedAt: DateTime
    --
    + getSummary(): String
}

class Milestone {
    - id: UUID
    - title: String
    - description: String
    - sequenceOrder: Integer
    - estimatedHours: Float
    - status: MilestoneStatus
    --
    + approve(): void
}

class Task {
    - id: UUID
    - title: String
    - estimatedMinutes: Integer
    - scheduledDate: Date [0..1]
    - startTime: Time [0..1]
    - endTime: Time [0..1]
    - status: TaskStatus
    - completedAt: DateTime [0..1]
    --
    + markCompleted(): void
    + cancel(): void
    + isOverdue(currentDate: Date): Boolean
    + reschedule(newDate: Date): void
}

class StudySession {
    - id: UUID
    - targetDurationMinutes: Integer
    - startedAt: DateTime
    - endedAt: DateTime [0..1]
    - status: SessionStatus
    - lastHeartbeatAt: DateTime
    --
    + start(): void
    + finish(): void
    + recordHeartbeat(): void
    + markAbandoned(): void
    + evaluateAbandonmentStatus(timeoutMinutes: Integer): SessionStatus
    + isTimedOut(timeoutMinutes: Integer): Boolean
}

class SessionTask {
    - id: UUID
    - allocatedMinutes: Integer
    - timeSpentMinutes: Integer
    - isCompletedInSession: Boolean
    --
    + recordProgress(minutes: Integer, completed: Boolean): void
}

class AvailabilityProfile {
    - id: UUID
    - mode: AvailabilityMode
    - weeklySchedule: Object
    --
    + getDailyCeiling(dayOfWeek: Integer): Integer
    + validateDailyCeiling(durationMinutes: Integer): Boolean
    + validateScheduleSlots(proposal: ScheduleProposal): Boolean
}

class ScheduleProposal {
    - id: UUID
    - proposalVersion: Integer
    - status: ProposalStatus
    - appliedAt: DateTime [0..1]
    --
    + apply(): void
    + reject(): void
    + validateConstraints(profile: AvailabilityProfile): Boolean
}

class PauseRecord {
    - id: UUID
    - pauseStartDate: Date
    - pauseEndDate: Date
    - shiftedDays: Integer
    - reason: String
    --
    + calculateShiftedDays(): Integer
}

class StudyNote {
    - id: UUID
    - content: String
    - noteType: NoteType
}

class AIReview {
    - id: UUID
    - milestoneId: UUID [0..1]
    - periodStart: Date [0..1]
    - periodEnd: Date [0..1]
    - reviewCycle: ReviewCycle
    - qualitativeFeedback: String
    - quantitativeSummary: Object
}

class WebCalToken {
    - id: UUID
    - tokenHash: String
    - isActive: Boolean
    - lastUsedAt: DateTime [0..1]
    - rotatedAt: DateTime [0..1]
    --
    + rotate(newHash: String): void
    + deactivate(): void
    + recordAccess(): void
}

class AIQuota {
    - id: UUID
    - monthlyLimit: Integer
    - usedCalls: Integer
    - reservedCalls: Integer
    - tokensConsumed: Long
    - cycleStart: DateTime
    - cycleEnd: DateTime
    --
    + hasRemainingQuota(): Boolean
    + reserve(): Boolean
    + commit(tokens: Integer): void
    + release(): void
    + resetCycle(): void
}

class AIQuotaReservation {
    - id: UUID
    - status: QuotaReservationStatus
    - estimatedTokens: Integer
    - tokensConsumed: Integer
    - expiresAt: DateTime
    - createdAt: DateTime
    --
    + commit(tokens: Integer): void
    + release(): void
    + markExpired(): void
    + isExpired(now: DateTime): Boolean
}

class LearnerProfile {
    - userId: UUID
    - optimalFocusDurationMins: Integer
    - peakProductivitySlots: Object
    - estimationBiasFactor: Float
    - weeklyCompletionRate: Float
    - totalCompletedSessions: Integer
    - isColdStart: Boolean
    - lastAggregatedAt: DateTime [0..1]
    --
    + recalculateProfile(sessions: List<StudySession>): void
    + resetProfile(): void
    + isEligibleForAdjustment(): Boolean
}

class TaskDependency {
    - predecessorId: UUID
    - successorId: UUID
    - roadmapId: UUID
    - createdAt: DateTime
    --
    + isValid(): Boolean
    + detectCycle(dependencies: List<TaskDependency>): Boolean
}

class ScheduleChangeLog {
    - id: UUID
    - roadmapId: UUID
    - taskId: UUID [0..1]
    - actorType: ScheduleActorType
    - action: String
    - oldValue: Object [0..1]
    - newValue: Object [0..1]
    - reason: String [0..1]
    - createdAt: DateTime
}

' ========================================================
' 2. CÁC TẬP KIỂU LIỆT KÊ (ENUMERATIONS)
' ========================================================

enum UserRole {
    LEARNER
    ADMIN
}

enum UserTier {
    FREE
    PREMIUM
}

enum GoalStatus {
    ACTIVE
    ARCHIVED
}

enum RoadmapStatus {
    INITIALIZED
    ACTIVE
    PAUSED
    COMPLETED
    ARCHIVED
}

enum MilestoneStatus {
    PENDING
    APPROVED
}

enum TaskStatus {
    PENDING
    TODO
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum SessionStatus {
    IN_PROGRESS
    COMPLETED
    PARTIAL_COMPLETED
    CANCELLED
}

enum ScheduleActorType {
    USER
    SYSTEM_ADAPT
    SYSTEM_DOMINO
    AI_PROPOSAL
}

enum AvailabilityMode {
    MODE_A_WEEKLY_RECURRING
    MODE_B_DYNAMIC_SLOTS
}

enum ProposalStatus {
    DRAFT
    APPLIED
    DISCARDED
}

enum NoteType {
    SCRATCHPAD
    TAKEAWAY
}

enum ReviewCycle {
    WEEKLY
    MILESTONE
}

enum QuotaReservationStatus {
    RESERVED
    COMMITTED
    RELEASED
    EXPIRED
}

' ========================================================
' 3. QUAN HỆ VÀ BẢN SỐ (ASSOCIATIONS & COMPOSITION)
' ========================================================

User "1" -- "0..*" Goal : "thiết lập"
User "1" -- "0..*" Roadmap : "sở hữu"
User "1" *-- "1" AvailabilityProfile : "cấu hình"
User "1" *-- "1" AIQuota : "sở hữu"
User "1" *-- "1" LearnerProfile : "khắc họa hồ sơ"
User "1" -- "0..1" WebCalToken : "cấp phát"
User "1" -- "0..*" StudySession : "thực hiện"

Goal "1" -- "0..*" Roadmap : "phân rã thành"

Roadmap "1" *-- "3..7" Milestone : "gồm các mốc"
Roadmap "1" *-- "0..1" OfficialSchedule : "áp dụng lịch chính thức"
Roadmap "1" o-- "0..*" ScheduleProposal : "có đề xuất lịch"
Roadmap "1" *-- "0..*" PauseRecord : "lưu vết tạm dừng"
Roadmap "1" -- "0..*" AIReview : "nhận đánh giá"
Roadmap "1" *-- "0..*" ScheduleChangeLog : "lưu vết biến động"

Milestone "1" *-- "1..*" Task : "chia nhỏ thành"

Task "1" *-- "0..*" TaskDependency : "nhiệm vụ tiên quyết"
Task "1" *-- "0..*" TaskDependency : "nhiệm vụ kế thừa"

StudySession "1" *-- "1..*" SessionTask : "gồm các task trong phiên"
SessionTask "0..*" -- "1" Task : "học nhiệm vụ"

StudySession "1" *-- "0..*" StudyNote : "ghi chép"

AIQuota "1" *-- "0..*" AIQuotaReservation : "ghi nhật ký giữ chỗ"

' Phụ thuộc vào Enumerations
User ..> UserRole
User ..> UserTier
Goal ..> GoalStatus
Roadmap ..> RoadmapStatus
Milestone ..> MilestoneStatus
Task ..> TaskStatus
StudySession ..> SessionStatus
AvailabilityProfile ..> AvailabilityMode
ScheduleProposal ..> ProposalStatus
StudyNote ..> NoteType
AIReview ..> ReviewCycle
AIQuotaReservation ..> QuotaReservationStatus
ScheduleChangeLog ..> ScheduleActorType

note "BUSR-02 (Human-in-the-Loop Cấp 1):\nMột Roadmap bao gồm từ 3 đến 7 Milestone,\nphải được phê duyệt trước khi phân rã Task." as N_MilestoneRule
Milestone .. N_MilestoneRule

note "BUSR-07 (Domino Shift):\nKhi Roadmap tạm dừng (PAUSED), phương thức\ncalculateDominoShift() trên Roadmap tịnh tiến tất định\ntoàn bộ Task chưa xong mà không gọi lại AI." as N_DominoRule
Roadmap .. N_DominoRule

note "BUSR-10 & OS-02 (Two-Phase Quota):\nAIQuotaReservation đóng vai trò sổ cái 2 pha\n(Reserve -> Commit/Release) với thời hạn expires_at,\nngăn chặn thất thoát hạn ngạch khi streaming lỗi." as N_QuotaRule
AIQuotaReservation .. N_QuotaRule

note "ADR-010 (Learner Profile & Zimmerman SRL):\nLearnerProfile tổng hợp thói quen người học bất đồng bộ,\nhiệu chỉnh hệ số chệch và ngắt mạch chống lặp quá hạn." as N_ProfileRule
LearnerProfile .. N_ProfileRule

note "ADR-009 (Constraint Validation Gate):\nScheduleProposal tự kiểm định qua validateConstraints():\nkhông vi phạm trần giờ rảnh và không có chu trình đồ thị (DAG)." as N_ConstraintRule
ScheduleProposal .. N_ConstraintRule

@enduml
