@startuml FocusFlow_Domain_Model
title FocusFlow — Mô hình Miền Nghiệp vụ (Domain Model / Conceptual Class Diagram)
' Phiên bản: v3.2 — 15 Khái niệm Miền Cốt lõi & Quan hệ Tiên quyết (Chuẩn Craig Larman: Không phương thức, Không thuộc tính khóa kỹ thuật)

skinparam roundcorner 10
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #2D3748
    FontStyle bold
}

skinparam enum {
    BackgroundColor #FFF5F5
    BorderColor #C53030
}

' ========================================================
' 1. CÁC KHÁI NIỆM MIỀN BÀI TOÁN (DOMAIN CONCEPTUAL CLASSES - 15 KHÁI NIỆM)
' Theo chuẩn Craig Larman: Chỉ bao gồm Tên lớp và Thuộc tính nghiệp vụ, TUYỆT ĐỐI KHÔNG CÓ PHƯƠNG THỨC
' ========================================================

class User {
    + fullName: String
    + email: String
    + timezone: String
    + role: UserRole
    + tier: UserTier
}

class Goal {
    + title: String
    + targetDate: Date
    + context: String
    + status: GoalStatus
}

class Roadmap {
    + title: String
    + startDate: Date
    + targetDate: Date
    + status: RoadmapStatus
}

class OfficialSchedule {
    + totalSessions: Integer
    + totalPlannedMinutes: Integer
    + activatedAt: DateTime
}

class Milestone {
    + title: String
    + description: String
    + sequenceOrder: Integer
    + estimatedHours: Float
    + status: MilestoneStatus
}

class Task {
    + title: String
    + estimatedMinutes: Integer
    + scheduledDate: Date [0..1]
    + status: TaskStatus
}

class StudySession {
    + targetDurationMinutes: Integer
    + startedAt: DateTime
    + endedAt: DateTime [0..1]
    + status: SessionStatus
}

class SessionTask {
    + allocatedMinutes: Integer
    + timeSpentMinutes: Integer
    + isCompletedInSession: Boolean
}

class AvailabilityProfile {
    + mode: AvailabilityMode
    + weeklySchedule: Object
}

class ScheduleProposal {
    + proposalVersion: Integer
    + status: ProposalStatus
}

class PauseRecord {
    + pauseStartDate: Date
    + pauseEndDate: Date
    + shiftedDays: Integer
    + reason: String
}

class StudyNote {
    + content: String
    + noteType: NoteType
}

class AIReview {
    + reviewCycle: ReviewCycle
    + quantitativeSummary: Object
    + qualitativeFeedback: String
}

class AIQuota {
    + monthlyLimit: Integer
    + usedCalls: Integer
    + reservedCalls: Integer
    + cycleStart: DateTime
    + cycleEnd: DateTime
}

class LearnerProfile {
    + optimalFocusDurationMins: Integer
    + peakProductivitySlots: Object
    + estimationBiasFactor: Float
    + weeklyCompletionRate: Float
    + totalCompletedSessions: Integer
    + isColdStart: Boolean
}

' ========================================================
' 2. CÁC TẬP KIỂU LIỆT KÊ (ENUMERATIONS)
' ========================================================

enum UserRole {
    LEARNER
    ADMIN
}

enum UserTier {
    FREE
    PREMIUM
}

enum GoalStatus {
    ACTIVE
    ARCHIVED
}

enum RoadmapStatus {
    INITIALIZED
    ACTIVE
    PAUSED
    COMPLETED
    ARCHIVED
}

enum MilestoneStatus {
    PENDING
    APPROVED
}

enum TaskStatus {
    PENDING
    TODO
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum SessionStatus {
    IN_PROGRESS
    COMPLETED
    PARTIAL_COMPLETED
    CANCELLED
}

enum AvailabilityMode {
    MODE_A_WEEKLY_RECURRING
    MODE_B_DYNAMIC_SLOTS
}

enum ProposalStatus {
    DRAFT
    APPLIED
    DISCARDED
}

enum NoteType {
    SCRATCHPAD
    TAKEAWAY
}

enum ReviewCycle {
    WEEKLY
    MILESTONE
}

' ========================================================
' 3. QUAN HỆ VÀ BẢN SỐ (ASSOCIATIONS & MULTIPLICITY)
' ========================================================

User "1" -- "0..*" Goal : "thiết lập"
User "1" -- "0..*" Roadmap : "sở hữu"
User "1" *-- "1" AvailabilityProfile : "cấu hình"
User "1" *-- "1" AIQuota : "sở hữu"
User "1" *-- "1" LearnerProfile : "khắc họa hồ sơ"
User "1" -- "0..*" StudySession : "thực hiện"

Goal "1" -- "0..*" Roadmap : "phân rã thành"

Roadmap "1" *-- "3..7" Milestone : "gồm các mốc"
Roadmap "1" *-- "0..1" OfficialSchedule : "áp dụng lịch chính thức"
Roadmap "1" o-- "0..*" ScheduleProposal : "có đề xuất lịch"
Roadmap "1" *-- "0..*" PauseRecord : "lưu vết tạm dừng"
Roadmap "1" -- "0..*" AIReview : "nhận đánh giá"

Milestone "1" *-- "1..*" Task : "chia nhỏ thành"
Task "0..*" -- "0..*" Task : "tiên quyết (DAG)"

StudySession "1" *-- "1..*" SessionTask : "gồm các task trong phiên"
SessionTask "0..*" -- "1" Task : "học nhiệm vụ"

StudySession "1" *-- "0..*" StudyNote : "ghi chép"

' Phụ thuộc vào Enumerations
User ..> UserRole
User ..> UserTier
Goal ..> GoalStatus
Roadmap ..> RoadmapStatus
Milestone ..> MilestoneStatus
Task ..> TaskStatus
StudySession ..> SessionStatus
AvailabilityProfile ..> AvailabilityMode
ScheduleProposal ..> ProposalStatus
StudyNote ..> NoteType
AIReview ..> ReviewCycle

note "BUSR-02 (Human-in-the-Loop Cấp 1):\nMột Roadmap bao gồm từ 3 đến 7 Milestone,\nphải được phê duyệt trước khi phân rã Task." as N_MilestoneRule
Milestone .. N_MilestoneRule

note "BUSR-07 (Domino Shift):\nKhi Roadmap tạm dừng (PAUSED),\ntoàn bộ Task chưa hoàn thành được\ntịnh tiến tất định: shiftedDays = pauseEndDate - pauseStartDate + 1." as N_DominoRule
PauseRecord .. N_DominoRule

@enduml
