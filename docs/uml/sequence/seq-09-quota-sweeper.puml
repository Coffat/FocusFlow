@startuml SD9_Quota_Sweeper
!theme plain
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10
skinparam ResponseMessageBelowArrow true

title UC-QUOTA-02: Tự động Quét & Hoàn trả Hạn ngạch AI Quá hạn Celery Beat (Use-Case Realization)

actor "Celery Beat\n(Periodic Timer)" as Beat
box "Message Broker & Queue" #FFF3CD
    participant "Redis 7.2\n(Message Broker)" as Broker
end box
box "Background Processing" #F8F9FA
    participant "QuotaSweeperWorker\n(Celery Task)" as Worker
end box
box "Application Layer" #DEE2E6
    participant "SweepExpiredReservationsUC\n(Use Case)" as SweepUC
end box
box "Infrastructure & Persistence" #CED4DA
    participant "SqlQuotaRepo\n(AIQuotaRepoPort)" as QuotaRepo
    participant "PostgreSQL 16\n(Database)" as DB
end box

note over Beat,DB: Tác vụ nền chạy định kỳ mỗi 5 phút quét sạch các reservation bị kẹt (RESERVED quá 5 phút)\ndo client ngắt kết nối SSE đột ngột hoặc tiến trình LLM worker gặp sự cố

Beat ->> Broker: enqueue_task("sweep_expired_quota_reservations")
note over Beat: Celery Beat đẩy task vào hàng đợi Redis bất đồng bộ không chặn

Broker ->> Worker: dispatch_task("sweep_expired_quota_reservations")
activate Worker

Worker -> SweepUC: execute(now=CURRENT_TIMESTAMP)
activate SweepUC

' Bước 1: Quét các reservation hết hạn qua Index tối ưu idx_quota_reservations_cleanup
SweepUC -> QuotaRepo: find_expired_reservations(cutoff_time=NOW())
activate QuotaRepo
QuotaRepo -> DB: SELECT id, user_id, estimated_tokens FROM ai_quota_reservations\nWHERE status = 'RESERVED' AND expires_at < NOW()\nFOR UPDATE SKIP LOCKED
activate DB
DB --> QuotaRepo: expiredReservationRecords
deactivate DB
QuotaRepo --> SweepUC: List[ExpiredReservation]
deactivate QuotaRepo

alt Không có reservation nào quá hạn
    SweepUC --> Worker: SweepSummaryDTO(swept_count=0)
else Có bản ghi reservation quá hạn bị treo
    loop Với mỗi expired_reservation trong danh sách
        SweepUC -> QuotaRepo: reclaim_expired_reservation(res.id, res.user_id)
        activate QuotaRepo
        
        note over QuotaRepo,DB: ACID Transaction hoàn trả hạn ngạch:\n1. UPDATE ai_quota_reservations SET status = 'EXPIRED', updated_at = NOW() WHERE id = :res_id\n2. UPDATE ai_quotas SET reserved_calls = GREATEST(0, reserved_calls - 1), updated_at = NOW() WHERE user_id = :user_id
        QuotaRepo -> DB: execute_atomic_reclaim(res.id, res.user_id)
        activate DB
        DB --> QuotaRepo: transaction_success
        deactivate DB
        
        QuotaRepo --> SweepUC: reclaimAck(res.id)
        deactivate QuotaRepo
    end
    
    SweepUC --> Worker: SweepSummaryDTO(swept_count=N)
    deactivate SweepUC
end

Worker -> Worker: log_summary_and_metrics("Swept expired reservations", swept_count)
deactivate Worker

@enduml
