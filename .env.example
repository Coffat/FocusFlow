# ==============================================================================
# FocusFlow — Môi trường Cấu hình Toàn hệ thống (Environment Variables Template)
# ==============================================================================

# --- MÔI TRƯỜNG HOẠT ĐỘNG ---
# development | staging | production | test
ENVIRONMENT=development
# Bắt buộc False khi ENVIRONMENT=staging hoặc production
DEBUG=True
PROJECT_NAME="FocusFlow"
VERSION="1.0.0"

# --- MẠNG & TÊN MIỀN (DOMAINS & PORTS) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- CƠ SỞ DỮ LIỆU POSTGRESQL 16 ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=focusflow_user
POSTGRES_PASSWORD=focusflow_secure_password
POSTGRES_DB=focusflow_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- BỘ NHỚ ĐỆM & HÀNG ĐỢI REDIS 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# --- BẢO MẬT & XÁC THỰC (AUTH & JWT) ---
# Sinh bằng: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_64_character_hex_key_for_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- TÍCH HỢP AI (COBHUB GATEWAY / GEMINI) ---
LLM_PROVIDER=gemini
# Bắt buộc cấu hình endpoint gateway cobhub khi chạy với LLM_PROVIDER=gemini (vd: http://127.0.0.1:8045)
LLM_BASE_URL=http://127.0.0.1:8045
LLM_API_KEY=your_cobhub_api_key_here
# Danh sách model dự phòng trên cùng gateway cobhub (phân cách bằng dấu phẩy; mặc định để trống nếu không cấu hình fallback tường minh)
LLM_FALLBACK_MODELS=
# Chế độ điều khiển thinking:
# - model_suffix (mặc định với Gemini/cobhub): chỉ dùng LLM_MODEL_LOW, LLM_MODEL_MEDIUM, LLM_MODEL_HIGH theo từng mức thinking (LLM_MODEL bị bỏ qua)
# - param (hoặc provider khác gemini): chỉ dùng LLM_MODEL và truyền thinking_level qua tham số API (LLM_MODEL_LOW/MEDIUM/HIGH bị bỏ qua)
LLM_THINKING_CONTROL=model_suffix
# Hoạt động khi LLM_THINKING_CONTROL=param (hoặc provider khác gemini)
LLM_MODEL=gemini-3.8-flash-medium
# Hoạt động khi LLM_PROVIDER=gemini và LLM_THINKING_CONTROL=model_suffix
LLM_MODEL_LOW=gemini-3.8-flash-low
LLM_MODEL_MEDIUM=gemini-3.8-flash-medium
LLM_MODEL_HIGH=gemini-3.8-flash-high
LLM_EMBEDDING_MODEL=gemini/gemini-embedding-2
AI_HARD_TIMEOUT_SECONDS=55

# --- EMBEDDING RIÊNG QUA GOOGLE AI STUDIO (KHÔNG QUA COBHUB) ---
EMBEDDING_PROVIDER=google_ai_studio
EMBEDDING_API_KEY=your_google_ai_studio_api_key_here
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=768

# --- WEBCAL EXPORT SECRET SALT ---
WEBCAL_SALT=change_this_to_another_secure_salt_for_webcal_token_hashing

# --- BẢO MẬT FERNET (MÃ HÓA DỮ LIỆU NHẠY CẢM) ---
FERNET_KEY=

# --- EMAIL & MAILPIT SMTP (OTP / THÔNG BÁO) ---
# smtp | console
EMAIL_BACKEND=smtp
# Trong Docker Compose dùng mailpit; chạy local host dùng localhost
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="FocusFlow Support <no-reply@focusflow.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- THANH TOÁN & LỊCH HỌC (CALENDAR / OAUTH) ---
# sepay | local_mock
PAYMENT_PROVIDER=sepay
# google | local_mock
CALENDAR_PROVIDER=google
# Sinh Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_ENCRYPTION_KEY=replace_with_fernet_key_for_calendar_oauth_tokens
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/account/calendar/google/callback
# Staging/Production nên dùng URL HTTPS công khai để nhận webhook từ Google Calendar
CALENDAR_WEBHOOK_BASE_URL=http://localhost:3000

# --- RAG KNOWLEDGE SOURCES ---
KNOWLEDGE_RAG_ENABLED=True
KNOWLEDGE_UPLOAD_DIR=/tmp/focusflow-knowledge
KNOWLEDGE_FILE_MAX_BYTES=20971520
KNOWLEDGE_URL_MAX_BYTES=5242880
KNOWLEDGE_URL_TIMEOUT_SECONDS=8.0
