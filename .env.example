# ==============================================================================
# FocusFlow — Môi trường Cấu hình Toàn hệ thống (Environment Variables Template)
# ==============================================================================

# --- MÔI TRƯỜNG HOẠT ĐỘNG ---
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="FocusFlow"
VERSION="1.0.0"

# --- MẠNG & TÊN MIỀN (DOMAINS & PORTS) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- CƠ SỞ DỮ LIỆU POSTGRESQL 16 ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=focusflow_user
POSTGRES_PASSWORD=focusflow_secure_password
POSTGRES_DB=focusflow_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- BỘ NHỚ ĐỆM & HÀNG ĐỢI REDIS 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# --- BẢO MẬT & XÁC THỰC (AUTH & JWT) ---
# Sinh bằng: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_64_character_hex_key_for_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- TÍCH HỢP AI GOOGLE GEMINI API ---
# Lấy API Key từ: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_HARD_TIMEOUT_SECONDS=55

# --- WEBCAL EXPORT SECRET SALT ---
WEBCAL_SALT=change_this_to_another_secure_salt_for_webcal_token_hashing
